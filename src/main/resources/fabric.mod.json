{
    "schemaVersion": 1,
    "id": "subtick-input-engine",
    "version": "${version}",

    "name": "SubTick Input Engine",
    "description": "Frame-aligned sub-tick input capture system. Eliminates click loss and input latency caused by Minecraft's 20 TPS tick loop by buffering inputs at render-frame rate.",
    "authors": [
        "SubTickDev"
    ],
    "contact": {
        "homepage": "",
        "sources": ""
    },
    "license": "MIT",
    "icon": "",

    "environment": "client",

    "entrypoints": {
        "client": [
            "com.subtick.SubTickInputEngine"
        ]
    },

    "mixins": [
        "subtick.mixins.json"
    ],

    "depends": {
        "fabricloader": ">=0.15.0",
        "minecraft": ">=1.21",
        "java": ">=17",
        "fabric-api": "*"
    },

    "suggests": {}
}
